# Node.js 20.19+ is required. Defaults work without copying this file.
NODE_ENV=development
# The server listens locally by default. Set HOST=0.0.0.0 for a trusted LAN/container.
HOST=127.0.0.1
PORT=3001
# Exact browser origin allowed by CORS (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
# Relative paths are resolved from the repository root, independent of the working directory.
DATABASE_PATH=server/data/lifeos.db
# API requests per IP per 60 seconds. JSON bodies are limited to 32 KB.
RATE_LIMIT_MAX=120

# Leave true for the offline demo. In live mode, goals and retrieved memories are
# sent to MODEL_BASE_URL. Never put model keys in VITE_* variables.
MOCK_MODE=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=meta-model-configure-me
# Provider adaptation: configurable auth header/prefix and JSON object mode.
MODEL_AUTH_HEADER=Authorization
MODEL_AUTH_PREFIX=Bearer
MODEL_JSON_MODE=true
MODEL_TIMEOUT_MS=8000
# Explicitly opt in to labeled offline fallback after a live call fails.
MOCK_FALLBACK=false

# Optional semantic reranking. Off by default: retrieval is keyword-only and needs no network.
# When enabled, memory key/value text and the goal are sent to this /embeddings endpoint.
EMBEDDINGS_ENABLED=false
# Leave blank to reuse MODEL_BASE_URL / MODEL_API_KEY when one provider hosts both models.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=embedding-model-configure-me
EMBEDDINGS_TIMEOUT_MS=8000
# Blend weight for the semantic component (0 = keyword only, 1 = semantic only).
EMBEDDINGS_WEIGHT=0.35

# Client dev server. Its /api proxy keeps browser requests same-origin.
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
