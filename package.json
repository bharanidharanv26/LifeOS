{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "description": "A personal work agent that remembers, plans, asks, acts, and learns.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,client -c cyan,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "demo": "node scripts/free-ports.mjs && npm run seed && npm run dev",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
